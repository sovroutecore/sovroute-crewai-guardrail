# LLM provider key (OpenAI or OpenRouter)
OPENAI_API_KEY=sk-your-api-key
# Optional: Uncomment for OpenRouter
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# CREWAI_MODEL=openai/gpt-4o-mini

# SovRoute Remote Streamable HTTP MCP Endpoint (15 free eval calls/day, then L402/x402 pay-per-call)
SOVROUTE_MCP_URL=https://node.sovroute.com/mcp

# Optional Pay-Per-Call headers (x402 Base USDC EIP-3009 or L402 Lightning macaroon:preimage)
SOVROUTE_PAYMENT_SIGNATURE=
SOVROUTE_L402_TOKEN=
